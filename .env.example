APP_NAME=Laravel
APP_ENV=local
# WAJIB di production (Railway). Buat dengan: php artisan key:generate --show
# Jika kosong, docker/start.sh membuat kunci sementara agar tidak 500,
# tetapi session akan hilang setiap redeploy.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Di Railway/PaaS, arahkan log ke stderr agar pesan error lengkap
# muncul langsung di Deploy Logs (bukan hanya di storage/logs).
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE
# ============================================================
# Lokal (default): SQLite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
#
# Railway MySQL: cukup isi salah satu cara berikut.
# 1) DB_URL / DATABASE_URL / MYSQL_URL (paling mudah, otomatis dibaca config/database.php)
# DB_URL=mysql://user:password@host:port/database
# 2) Atau variabel MYSQL* dari plugin Railway (juga dibaca otomatis sebagai fallback):
# MYSQLHOST=...
# MYSQLPORT=...
# MYSQLDATABASE=...
# MYSQLUSER=...
# MYSQLPASSWORD=...

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true di production HTTPS (cookie hanya dikirim lewat HTTPS).
# Biarkan false untuk development lokal di http://localhost.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# TrustProxies di bootstrap/app.php sudah diset '*' (semua proxy) untuk Railway/PaaS.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
